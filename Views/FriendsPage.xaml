<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PayBuddyApp.Views.FriendsPage"
    Title="Venner"
    BackgroundColor="#F5F6FA">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,20,20,10" ColumnDefinitions="Auto,*">
            <Button Text="←"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BackgroundColor="White"
                    TextColor="#1F2937"
                    Clicked="OnBackClicked" />

            <Label Grid.Column="1"
                   Text="Venner"
                   FontSize="26"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   TextColor="#1F2937" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Friends}"
                        Margin="20,10,20,20"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Du har ingen venner endnu."
                       TextColor="#6B7280" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="14"
                           Margin="0,0,0,10"
                           CornerRadius="16"
                           BackgroundColor="White"
                           HasShadow="False"
                           BorderColor="#E5E7EB">
                        <Grid ColumnDefinitions="50,*,Auto">
                            <Frame WidthRequest="42"
                                   HeightRequest="42"
                                   CornerRadius="21"
                                   Padding="0"
                                   BackgroundColor="#EEF2FF"
                                   HasShadow="False">
                                <Label Text="👤"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="20" />
                            </Frame>

                            <Label Grid.Column="1"
                                   Text="{Binding FriendUserName}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#1F2937" />

                            <Button Grid.Column="2"
                                    Text="Fjern"
                                    BackgroundColor="#FBEAEA"
                                    TextColor="#E17055"
                                    CornerRadius="12"
                                    Padding="14,8"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFriendCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>