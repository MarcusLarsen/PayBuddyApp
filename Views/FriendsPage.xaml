<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:PayBuddyApp.Controls"
    x:Class="PayBuddyApp.Views.FriendsPage"
    Title="Venner"
    BackgroundColor="#F5F6FA">

    <Grid RowDefinitions="*,90">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="18">

                <Label Text="Venner"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />

                <Label Text="Venneanmodninger"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />

                <CollectionView ItemsSource="{Binding FriendRequests}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Ingen venneanmodninger." TextColor="#6B7280" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="14"
                                   Margin="0,0,0,10"
                                   CornerRadius="16"
                                   BackgroundColor="White"
                                   HasShadow="False"
                                   BorderColor="#E5E7EB">

                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding UserName}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#1F2937" />

                                    <Label Text="{Binding CreatedAt, StringFormat='Sendt: {0:dd.MM.yyyy}'}"
                                           FontSize="12"
                                           TextColor="#6B7280" />

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Text="Accepter"
                                                BackgroundColor="#E8F7F0"
                                                TextColor="#008B94"
                                                CornerRadius="12"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptRequestCommand}"
                                                CommandParameter="{Binding .}" />

                                        <Button Grid.Column="1"
                                                Text="Afvis"
                                                BackgroundColor="#FBEAEA"
                                                TextColor="#E17055"
                                                CornerRadius="12"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeclineRequestCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Dine venner"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1F2937" />

                <CollectionView ItemsSource="{Binding Friends}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Du har ingen venner endnu." TextColor="#6B7280" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="14"
                                   Margin="0,0,0,10"
                                   CornerRadius="16"
                                   BackgroundColor="White"
                                   HasShadow="False"
                                   BorderColor="#E5E7EB">

                                <Grid ColumnDefinitions="50,*,Auto">
                                    <Label Text="👤" FontSize="22" VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding FriendUserName}"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="#1F2937" />

                                    <Button Grid.Column="2"
                                            Text="Fjern"
                                            BackgroundColor="#FBEAEA"
                                            TextColor="#E17055"
                                            CornerRadius="12"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveFriendCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <controls:BottomNavBar Grid.Row="1" />
    </Grid>
</ContentPage>