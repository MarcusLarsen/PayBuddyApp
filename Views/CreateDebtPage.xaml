<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PayBuddyApp.Views.CreateDebtPage"
    Title="Opret gæld"
    BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Grid ColumnDefinitions="Auto,*">
                <Button Text="←"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="White"
                        TextColor="#1F2937"
                        Clicked="OnBackClicked" />

                <Label Grid.Column="1"
                       Text="Opret gæld"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="#1F2937" />
            </Grid>

            <Frame CornerRadius="18"
                   Padding="18"
                   BackgroundColor="White"
                   HasShadow="False"
                   BorderColor="#E5E7EB">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Vælg ven"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Picker Title="Vælg en ven"
                            ItemsSource="{Binding Friends}"
                            ItemDisplayBinding="{Binding FriendUserName}"
                            SelectedItem="{Binding SelectedFriend}"
                            TextColor="#1F2937"
                            TitleColor="#9CA3AF"
                            BackgroundColor="White" />

                    <Label Text="Beløb"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Entry Placeholder="Fx 150"
                           Keyboard="Numeric"
                           Text="{Binding AmountText}"
                           TextColor="#1F2937"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="White"
                           CursorPosition="0" />

                    <Label Text="Beskrivelse"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Editor Placeholder="Fx Pizza, transport eller lån..."
                            AutoSize="TextChanges"
                            HeightRequest="110"
                            Text="{Binding Description}"
                            TextColor="#1F2937"
                            PlaceholderColor="#9CA3AF"
                            BackgroundColor="White" />

                    <Button Text="Send gældsanmodning"
                            BackgroundColor="#6C5CE7"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            Command="{Binding CreateDebtCommand}" />

                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>